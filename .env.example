# TMDB API key (required) — https://www.themoviedb.org/settings/api
PUBLIC_TMDB_API_KEY=

# Supabase project (optional — auth/watchlist fall back to localStorage if unset)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional overrides, defaults shown
PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
