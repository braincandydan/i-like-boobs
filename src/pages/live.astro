---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

// Official FORMULA 1 YouTube channel
const F1_CHANNEL_ID = 'UCB_qr75-ydFVKSF9Dmo6izg';
const F1_UPLOADS_PLAYLIST = 'UU' + F1_CHANNEL_ID.slice(2);
const liveUrl = `https://www.youtube.com/embed/live_stream?channel=${F1_CHANNEL_ID}`;
const highlightsUrl = `https://www.youtube.com/embed/videoseries?list=${F1_UPLOADS_PLAYLIST}`;
---

<Layout title="Live - NotFlix">
  <Navbar />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-4xl font-bold text-white mb-12">Live</h1>

    <section class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-2">Formula 1 — Live</h2>
      <p class="text-gray-400 mb-6">
        Official FORMULA 1 YouTube live streams. If nothing is live right now, the player will show as offline.
      </p>
      <div class="aspect-video w-full bg-black rounded-lg overflow-hidden">
        <iframe
          src={liveUrl}
          title="Formula 1 live"
          class="w-full h-full"
          allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold text-white mb-2">Formula 1 — Replays &amp; Highlights</h2>
      <p class="text-gray-400 mb-6">Latest uploads from the official FORMULA 1 channel.</p>
      <div class="aspect-video w-full bg-black rounded-lg overflow-hidden">
        <iframe
          src={highlightsUrl}
          title="Formula 1 replays and highlights"
          class="w-full h-full"
          loading="lazy"
          allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </section>
  </main>
</Layout>
