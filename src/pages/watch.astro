---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { createUrl } from '../lib/utils';

// In static mode, we'll handle URL parameters client-side
// The server-side code will just render the basic structure
---

<Layout title="Watch - NotFlix">
  <Navbar />
  
  <!-- Loading Screen -->
  <div id="loading-screen" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center py-20">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto mb-4"></div>
      <p class="text-white">Loading video player...</p>
    </div>
  </div>

  <!-- Error Screen -->
  <div id="error-screen" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 hidden">
    <div class="text-center py-20">
      <i class="fas fa-exclamation-triangle text-6xl text-red-600 mb-6"></i>
      <h1 class="text-3xl font-bold text-white mb-4">Content Not Found</h1>
      <p class="text-gray-400 mb-8">
        No movie or TV show ID provided in the URL.
      </p>
      <a href={createUrl("/")} class="btn-primary">
        <i class="fas fa-home mr-2"></i>
        Back to Home
      </a>
    </div>
  </div>

  <!-- Video Player Section -->
  <div id="player-container" class="relative w-full hidden">
    <!-- Player Header -->
    <div class="bg-black bg-opacity-50 p-4">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <a id="back-link" href={createUrl("/")} class="text-white hover:text-red-600 transition-colors">
            <i class="fas fa-arrow-left text-xl"></i>
          </a>
          <h1 id="video-title" class="text-xl font-bold text-white">
            Loading...
          </h1>
        </div>
        
        <!-- Server Selection -->
        <div class="flex items-center space-x-2">
          <span class="text-white text-sm">Server:</span>
          <select id="server-select" class="bg-gray-800 text-white px-3 py-1 rounded text-sm">
            <option value="">Loading...</option>
          </select>
        </div>
      </div>
    </div>
    
    <!-- Resume Banner -->
    <div id="resume-banner" class="bg-gray-800 border-b border-gray-700 px-4 py-2 hidden">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <span class="text-gray-300 text-sm"><i class="fas fa-history mr-2 text-red-500"></i>Continue from <strong id="resume-time">0:00</strong>?</span>
        <div class="flex gap-2">
          <button id="resume-btn" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-sm transition-colors">Resume</button>
          <button id="resume-dismiss-btn" class="text-gray-400 hover:text-white px-3 py-1 text-sm transition-colors">Start Over</button>
        </div>
      </div>
    </div>

    <!-- Video Player -->
    <div class="relative w-full amazon-silk-fix" style="padding-bottom: 56.25%; height: 0;">
      <!-- Iframe Player (for streaming servers) -->
      <iframe
        id="video-player"
        src=""
        class="absolute top-0 left-0 w-full h-full amazon-silk-iframe"
        frameborder="0"
        allowfullscreen
        allow="autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen"
        referrerpolicy="origin"
        title="Video Player"
        scrolling="no"
      ></iframe>
      
      <!-- WebTorrent Player (for torrent playback) -->
      <div id="webtorrent-container" class="absolute top-0 left-0 w-full h-full hidden">
        <video
          id="webtorrent-player"
          class="w-full h-full"
          controls
          autoplay
        ></video>
        
        <!-- WebTorrent Status -->
        <div id="webtorrent-status" class="absolute top-4 left-4 bg-black bg-opacity-70 text-white px-4 py-2 rounded text-sm">
          <div class="flex items-center space-x-2">
            <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
            <span>Connecting to peers...</span>
          </div>
        </div>
        
        <!-- WebTorrent Progress -->
        <div id="webtorrent-progress" class="absolute bottom-4 left-4 right-4 bg-black bg-opacity-70 rounded p-2 hidden">
          <div class="flex items-center justify-between text-white text-xs mb-1">
            <span>Download Speed: <span id="download-speed">0</span> MB/s</span>
            <span>Upload Speed: <span id="upload-speed">0</span> MB/s</span>
          </div>
          <div class="w-full bg-gray-700 rounded-full h-2">
            <div id="progress-bar" class="bg-red-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
          <div class="text-white text-xs mt-1">
            <span>Progress: <span id="progress-text">0%</span></span>
            <span class="ml-4">Peers: <span id="peer-count">0</span></span>
          </div>
        </div>
      </div>
      
      <!-- Auto Next Episode Overlay -->
      <div id="next-episode-overlay" class="absolute inset-0 flex items-center justify-center z-20 hidden pointer-events-none" style="background:rgba(0,0,0,0.75);">
        <div class="bg-gray-900 rounded-xl p-6 pointer-events-auto shadow-2xl text-center" style="min-width: 300px; max-width: 380px;">
          <p class="text-gray-400 text-xs uppercase tracking-widest mb-2">Episode Finished</p>
          <p class="text-white font-bold text-lg mb-1">Up Next</p>
          <p id="next-episode-label" class="text-red-400 font-semibold text-base mb-4">Next Episode</p>
          <p class="text-gray-300 text-sm mb-5">Starting in <span id="next-episode-countdown" class="text-white font-bold">5</span> seconds…</p>
          <div class="flex items-center gap-3 justify-center">
            <button id="next-episode-play-btn" class="bg-red-600 hover:bg-red-700 text-white px-5 py-2 rounded-lg text-sm font-semibold transition-colors">
              Play Now
            </button>
            <button id="next-episode-cancel-btn" class="bg-gray-700 hover:bg-gray-600 text-white px-5 py-2 rounded-lg text-sm transition-colors">
              Cancel
            </button>
          </div>
        </div>
      </div>

      <!-- Fullscreen episode controls (TV shows) — revealed by hovering top edge -->
      <div id="fullscreen-controls" class="absolute top-0 left-0 right-0 z-40 hidden">
        <div class="bg-gradient-to-b from-black/95 via-black/80 to-transparent pt-4 pb-10 px-6">
          <div class="flex items-center justify-between gap-4 flex-wrap">
            <div class="min-w-0">
              <p id="fs-title" class="text-white font-bold text-base truncate"></p>
              <p id="fs-ep-label" class="text-gray-400 text-sm"></p>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <button id="fs-prev-btn" class="flex items-center gap-2 bg-white/15 hover:bg-white/25 text-white px-4 py-2 rounded-lg text-sm transition-colors">
                <i class="fas fa-step-backward"></i> Prev
              </button>
              <select id="fs-season-select" class="bg-gray-800 text-white px-3 py-2 rounded-lg text-sm border border-gray-600 focus:outline-none focus:border-red-500"></select>
              <select id="fs-episode-select" class="bg-gray-800 text-white px-3 py-2 rounded-lg text-sm border border-gray-600 focus:outline-none focus:border-red-500 max-w-52"></select>
              <button id="fs-next-btn" class="flex items-center gap-2 bg-white/15 hover:bg-white/25 text-white px-4 py-2 rounded-lg text-sm transition-colors">
                Next <i class="fas fa-step-forward"></i>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Invisible hover trigger strip — sits above iframe at the very top -->
      <div id="fs-trigger-zone" class="absolute top-0 left-0 right-0 z-50" style="height:48px; pointer-events:none;"></div>

      <!-- Server loading indicator -->
      <div id="server-loading" class="absolute inset-0 flex items-center justify-center bg-black/70 text-white z-25 hidden">
        <div class="text-center">
          <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto mb-4"></div>
          <p id="server-loading-msg">Loading server...</p>
        </div>
      </div>

      <!-- All servers failed overlay -->
      <div id="server-error-overlay" class="absolute inset-0 flex items-center justify-center bg-black/90 text-white z-30 hidden">
        <div class="text-center p-8 max-w-md">
          <i class="fas fa-exclamation-triangle text-5xl text-yellow-500 mb-4"></i>
          <h3 class="text-xl font-bold mb-2">All Sources Unavailable</h3>
          <p class="text-gray-400 mb-6">None of the streaming servers could load this content. This may be a temporary issue.</p>
          <div class="flex gap-3 justify-center">
            <button id="retry-all-btn" class="bg-red-600 hover:bg-red-700 text-white px-5 py-2 rounded transition-colors">
              <i class="fas fa-redo mr-2"></i>Try Again
            </button>
            <button id="report-issue-btn-overlay" class="bg-gray-700 hover:bg-gray-600 text-white px-5 py-2 rounded transition-colors">
              <i class="fas fa-flag mr-2"></i>Report Issue
            </button>
          </div>
        </div>
      </div>
    </div>
    
    <!-- WebTorrent Input Modal -->
    <div id="webtorrent-modal" class="fixed inset-0 bg-black bg-opacity-75 z-50 hidden flex items-center justify-center">
      <div class="bg-gray-900 rounded-lg p-6 max-w-2xl w-full mx-4">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-xl font-bold text-white">Load WebTorrent</h3>
          <button id="close-webtorrent-modal" class="text-gray-400 hover:text-white">
            <i class="fas fa-times text-xl"></i>
          </button>
        </div>
        <p class="text-gray-300 mb-4">Enter a magnet link or select a torrent file to stream:</p>
        <div class="space-y-4">
          <div>
            <label class="block text-white text-sm font-medium mb-2">Magnet Link:</label>
            <input
              type="text"
              id="magnet-input"
              placeholder="magnet:?xt=urn:btih:..."
              class="w-full bg-gray-800 text-white px-4 py-2 rounded border border-gray-600 focus:border-red-600 focus:outline-none"
            />
          </div>
          <div class="text-center text-gray-400 text-sm">OR</div>
          <div>
            <label class="block text-white text-sm font-medium mb-2">Torrent File:</label>
            <input
              type="file"
              id="torrent-file-input"
              accept=".torrent"
              class="w-full bg-gray-800 text-white px-4 py-2 rounded border border-gray-600 focus:border-red-600 focus:outline-none"
            />
          </div>
          <div class="flex space-x-4">
            <button
              id="load-webtorrent-btn"
              class="flex-1 bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded transition-colors"
            >
              <i class="fas fa-play mr-2"></i>
              Load Torrent
            </button>
            <button
              id="cancel-webtorrent-btn"
              class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded transition-colors"
            >
              Cancel
            </button>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Player Controls & Info -->
    <div class="bg-gray-900 p-4">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row gap-6">
          <!-- Movie Info -->
          <div class="flex-1">
            <h2 id="content-title" class="text-2xl font-bold text-white mb-2">Loading...</h2>
            <p id="content-overview" class="text-gray-300 text-sm leading-relaxed mb-4"></p>
            
            <!-- Episode Selector for TV Shows -->
            <div id="episode-controls" class="flex flex-col gap-4 mb-4 hidden">
              <div class="flex flex-wrap gap-4">
                <div class="flex items-center space-x-2">
                  <label class="text-white text-sm font-medium">Season:</label>
                  <select id="season-select" class="bg-gray-800 text-white px-3 py-2 rounded text-sm border border-gray-600 focus:border-red-600 focus:outline-none">
                    <option value="1">Season 1</option>
                  </select>
                </div>
                <div class="flex items-center space-x-2">
                  <label class="text-white text-sm font-medium">Episode:</label>
                  <select id="episode-select" class="bg-gray-800 text-white px-3 py-2 rounded text-sm border border-gray-600 focus:border-red-600 focus:outline-none">
                    <option value="1">Episode 1</option>
                  </select>
                </div>
                <button id="load-episode-btn" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded text-sm transition-colors">
                  <i class="fas fa-play mr-2"></i>
                  Load Episode
                </button>
              </div>
              
              <!-- Episode Info -->
              <div id="episode-info" class="bg-gray-800 rounded-lg p-3 hidden">
                <h4 id="episode-title" class="text-white font-semibold mb-1"></h4>
                <p id="episode-overview" class="text-gray-300 text-sm"></p>
              </div>
            </div>
          </div>
          
          <!-- Action Buttons -->
          <div class="flex flex-col space-y-2 md:w-64">
            <a id="details-link" href={createUrl("/")} class="btn-secondary text-center">
              <i class="fas fa-info-circle mr-2"></i>
              View Details
            </a>
            <button onclick="toggleFullscreen()" class="btn-secondary">
              <i class="fas fa-expand mr-2"></i>
              Fullscreen
            </button>
            <button onclick="reportIssue()" class="bg-yellow-600 hover:bg-yellow-700 text-white px-4 py-2 rounded text-sm">
              <i class="fas fa-flag mr-2"></i>
              Report Issue
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Popup Block Notification -->
  <div id="popup-notification" class="fixed top-4 right-4 bg-green-600 text-white px-4 py-2 rounded-lg shadow-lg z-50 hidden">
    <div class="flex items-center">
      <i class="fas fa-shield-alt mr-2"></i>
      <span>Popup blocked!</span>
    </div>
  </div>
</Layout>

<style>
  /* Additional iframe protection styles */
  #video-player {
    pointer-events: auto;
    /* Prevent selection of iframe content */
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
  }
  
  /* Popup notification animation */
  #popup-notification {
    transition: all 0.3s ease-in-out;
    transform: translateX(100%);
  }
  
  #popup-notification.show {
    transform: translateX(0);
  }
  
  /* Prevent drag and drop on video player */
  #video-player {
    -webkit-user-drag: none;
    -khtml-user-drag: none;
    -moz-user-drag: none;
    -o-user-drag: none;
    user-drag: none;
  }
</style>

<script>
  import { createUrl } from '../lib/utils';

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  // Origins the embed players may post messages from (filled in by initializeWatchPage)
  const embedOrigins = new Set<string>();

  // Only trust postMessage events that come from the player iframe or a known embed origin
  function isEmbedMessage(e: MessageEvent) {
    const iframe = document.getElementById('video-player') as HTMLIFrameElement | null;
    return (!!iframe && e.source === iframe.contentWindow) || embedOrigins.has(e.origin);
  }

  // Show popup blocked notification
  function showPopupBlockedNotification() {
    const notification = document.getElementById('popup-notification');
    if (notification) {
      notification.classList.remove('hidden');
      notification.classList.add('show');
      
      setTimeout(() => {
        notification.classList.remove('show');
        setTimeout(() => {
          notification.classList.add('hidden');
        }, 300);
      }, 3000);
    }
  }
  
  // Minimal popup blocking - only log attempts for debugging
  const originalWindowOpen = window.open;
  window.open = function(url, name, specs) {
    console.log('Popup attempt detected:', url);
    // Allow all popups for now to ensure video controls work
    return originalWindowOpen.call(window, url, name, specs);
  };
  
  // Block focus/blur popup tricks
  let userInteracted = false;
  document.addEventListener('click', () => { userInteracted = true; }, { once: true });
  
  window.addEventListener('blur', (e) => {
    if (!userInteracted) {
      e.preventDefault();
      e.stopPropagation();
      window.focus();
    }
  });
  
  // Wait for DOM to be ready
  // Astro bundles scripts as ES modules (deferred), so DOMContentLoaded may have
  // already fired by the time the listener is registered. Check readyState first.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initializeWatchPage();
      setupPopupBlocker();
    });
  } else {
    initializeWatchPage();
    setupPopupBlocker();
  }
  
  function initializeWatchPage() {
    // Monitor CSP violations to see what's being blocked
    if (window.SecurityPolicyViolationEvent) {
      document.addEventListener('securitypolicyviolation', (e) => {
        console.warn('CSP Violation detected:', {
          blockedURI: e.blockedURI,
          violatedDirective: e.violatedDirective,
          effectiveDirective: e.effectiveDirective,
          sourceFile: e.sourceFile,
          lineNumber: e.lineNumber,
          columnNumber: e.columnNumber
        });
      });
    }
    
    // Get URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    const type = urlParams.get('type') || 'movie';
    const id = urlParams.get('id');
    const title = urlParams.get('title') || 'Unknown';
    const season = urlParams.get('season') || '1';
    const episode = urlParams.get('episode') || '1';
    const magnetLink = urlParams.get('magnet'); // Get magnet link if provided
    
    // Get DOM elements
    const loadingScreen = document.getElementById('loading-screen');
    const errorScreen = document.getElementById('error-screen');
    const playerContainer = document.getElementById('player-container');
    const videoPlayer = document.getElementById('video-player');
    const serverSelect = document.getElementById('server-select');
    const videoTitle = document.getElementById('video-title');
    const contentTitle = document.getElementById('content-title');
    const backLink = document.getElementById('back-link');
    const detailsLink = document.getElementById('details-link');
    
    // Check if we have required parameters
    if (!id) {
      showError();
      return;
    }
    
    // Hide loading, show player
    loadingScreen.classList.add('hidden');
    playerContainer.classList.remove('hidden');
    
    // Current episode (changes without a page reload when the user switches episode)
    let curSeason = season;
    let curEpisode = episode;

    // Server priority: newest working domains first → fallbacks → WebTorrent
    // URLs are built lazily so they always reflect the current season/episode.
    const epPath = () => type === 'tv' ? `/${curSeason}/${curEpisode}` : '';
    const alternativeServers = [
      { name: 'VidSrc SH', url: () => `https://vidsrc.sh/embed/${type}/${id}${epPath()}?autoplay=1`, playerType: 'iframe' },
      { name: 'VidSrc TO', url: () => `https://vidsrc.to/embed/${type}/${id}${epPath()}`, playerType: 'iframe' },
      { name: 'VidSrcMe RU', url: () => `https://vidsrcme.ru/embed/${type}/${id}${epPath()}?autoplay=1`, playerType: 'iframe' },
      { name: 'VidSrcMe SU', url: () => `https://vidsrcme.su/embed/${type}/${id}${epPath()}?autoplay=1`, playerType: 'iframe' },
      { name: 'VidSrc-me RU', url: () => `https://vidsrc-me.ru/embed/${type}/${id}${epPath()}?autoplay=1`, playerType: 'iframe' },
      { name: 'VidSrc-me SU', url: () => `https://vidsrc-me.su/embed/${type}/${id}${epPath()}?autoplay=1`, playerType: 'iframe' },
      { name: 'VidSrc-embed RU', url: () => `https://vidsrc-embed.ru/embed/${type}/${id}${epPath()}?autoplay=1`, playerType: 'iframe' },
      { name: 'VidSrc-embed SU', url: () => `https://vidsrc-embed.su/embed/${type}/${id}${epPath()}?autoplay=1`, playerType: 'iframe' },
      { name: 'Vsrc SU', url: () => `https://vsrc.su/embed/${type}/${id}${epPath()}?autoplay=1`, playerType: 'iframe' },
      { name: 'SuperEmbed', url: () => `https://multiembed.mov/directstream.php?video_id=${id}&tmdb=1${type === 'tv' ? `&s=${curSeason}&e=${curEpisode}` : ''}`, playerType: 'iframe' },
      { name: 'EmbedSu', url: () => `https://embed.su/embed/${type}/${id}${epPath()}`, playerType: 'iframe' },
      { name: 'WebTorrent', url: () => 'webtorrent', playerType: 'webtorrent' }
    ];

    // Origins the embed players may legitimately post messages from
    alternativeServers
      .filter(s => s.playerType === 'iframe')
      .forEach(s => embedOrigins.add(new URL(s.url()).origin));
    embedOrigins.add('https://theajack.github.io');

    // Monitor iframe src changes
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.type === 'attributes' && mutation.attributeName === 'src') {
          console.log('Iframe src changed to:', videoPlayer.src);
        }
      });
    });
    observer.observe(videoPlayer, { attributes: true, attributeFilter: ['src'] });
    
    
    // Update titles
    const displayTitle = type === 'tv' ? `${title} S${season}E${episode}` : title;
    videoTitle.textContent = displayTitle;
    contentTitle.textContent = title;
    document.title = `Watch ${title} - NotFlix`;
    
    // Update navigation links with proper base path
    backLink.href = createUrl(`details/${type}/${id}`);
    detailsLink.href = createUrl(`details/${type}/${id}`);

    // --- Progress Tracking ---
    function progressKey() {
      const s = type === 'tv' ? `_s${curSeason}_e${curEpisode}` : '';
      return `notflix_progress_${type}_${id}${s}`;
    }
    function formatTime(secs) {
      const m = Math.floor(secs / 60);
      const s = Math.floor(secs % 60);
      return `${m}:${s.toString().padStart(2, '0')}`;
    }
    let elapsedSeconds = 0;
    let progressInterval = null;

    function startProgressTracking() {
      clearInterval(progressInterval);
      progressInterval = setInterval(() => {
        elapsedSeconds++;
        if (elapsedSeconds % 30 === 0) saveProgress();
      }, 1000);
    }
    function saveProgress() {
      if (elapsedSeconds < 60) return;
      try {
        // Don't overwrite a larger saved resume point the user hasn't acted on yet
        const raw = localStorage.getItem(progressKey());
        if (raw && JSON.parse(raw).elapsed > elapsedSeconds) return;
      } catch (_) {}
      localStorage.setItem(progressKey(), JSON.stringify({ elapsed: elapsedSeconds, savedAt: Date.now() }));
    }
    function clearProgress() {
      localStorage.removeItem(progressKey());
    }
    let resumeFrom = 0;
    const resumeBanner = document.getElementById('resume-banner');
    document.getElementById('resume-btn').addEventListener('click', () => {
      resumeBanner.classList.add('hidden');
      const sep = videoPlayer.src.includes('?') ? '&' : '?';
      videoPlayer.src = videoPlayer.src + sep + `t=${resumeFrom}`;
      elapsedSeconds = resumeFrom;
      startProgressTracking();
    });
    document.getElementById('resume-dismiss-btn').addEventListener('click', () => {
      resumeBanner.classList.add('hidden');
      clearProgress();
      startProgressTracking();
    });
    function checkSavedProgress() {
      resumeBanner.classList.add('hidden');
      try {
        const raw = localStorage.getItem(progressKey());
        if (!raw) return;
        const { elapsed, savedAt } = JSON.parse(raw);
        if (Date.now() - savedAt > 90 * 24 * 60 * 60 * 1000) { clearProgress(); return; }
        if (elapsed < 60) return;
        resumeFrom = elapsed;
        document.getElementById('resume-time').textContent = formatTime(elapsed);
        resumeBanner.classList.remove('hidden');
      } catch (_) {}
    }

    // Called when the user moves to a different episode without a page reload
    function switchEpisode(newSeason, newEpisode) {
      curSeason = String(newSeason);
      curEpisode = String(newEpisode);
      clearInterval(progressInterval);
      elapsedSeconds = 0;
      videoTitle.textContent = `${title} S${curSeason}E${curEpisode}`;
      // Only touch the iframe when it is the active player (not while a torrent is playing)
      if (alternativeServers[currentServerIndex]?.playerType === 'iframe') {
        loadServer(currentServerIndex);
      }
      checkSavedProgress();
    }

    // A finished movie has nothing to resume
    window.addEventListener('message', (e) => {
      if (type !== 'movie' || !isEmbedMessage(e)) return;
      try {
        const data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
        const evt = (data?.event ?? data?.type ?? data?.name ?? data?.status ?? '').toString().toLowerCase();
        if (evt === 'ended' || evt === 'complete' || evt === 'finish') {
          clearInterval(progressInterval);
          elapsedSeconds = 0;
          clearProgress();
        }
      } catch (_) {}
    });

    window.addEventListener('beforeunload', saveProgress);
    window.addEventListener('visibilitychange', () => { if (document.hidden) saveProgress(); });

    // Set up server switching with error handling
    let currentServerIndex = 0;
    let webtorrentClient = null;
    let webtorrentTorrent = null;
    let serverStallTimeout = null;
    let lastIframeServerIndex = 0; // last iframe server used, to fall back to if the torrent modal is cancelled

    function showServerErrorOverlay() {
      document.getElementById('server-loading').classList.add('hidden');
      document.getElementById('server-error-overlay').classList.remove('hidden');
    }

    // Move to the next iframe server, or show the error overlay if there isn't one
    // (failover never jumps into the WebTorrent modal on its own)
    function failoverToNextServer() {
      const next = alternativeServers[currentServerIndex + 1];
      if (next && next.playerType === 'iframe') {
        loadServer(currentServerIndex + 1);
      } else {
        showServerErrorOverlay();
      }
    }

    function loadServer(index) {
      if (index >= alternativeServers.length) return;
      const server = alternativeServers[index];
      const serverLoading = document.getElementById('server-loading');
      const serverLoadingMsg = document.getElementById('server-loading-msg');
      const videoPlayer = document.getElementById('video-player');
      const webtorrentContainer = document.getElementById('webtorrent-container');

      document.getElementById('server-error-overlay').classList.add('hidden');
      serverLoadingMsg.textContent = `Trying ${server.name}…`;
      serverLoading.classList.remove('hidden');
      clearTimeout(serverStallTimeout);

      if (server.playerType === 'webtorrent') {
        showWebTorrentModal();
        serverSelect.selectedIndex = index;
        currentServerIndex = index;
        serverLoading.classList.add('hidden');
      } else {
        webtorrentContainer.classList.add('hidden');
        videoPlayer.classList.remove('hidden');
        if (webtorrentClient) {
          webtorrentClient.destroy();
          webtorrentClient = null;
          webtorrentTorrent = null;
        }
        // Tear down the torrent <video> so it doesn't keep playing/buffering unseen
        const torrentVideo = document.getElementById('webtorrent-player') as HTMLVideoElement | null;
        if (torrentVideo) {
          torrentVideo.pause();
          torrentVideo.removeAttribute('src');
          torrentVideo.load();
        }
        videoPlayer.src = server.url();
        serverSelect.selectedIndex = index;
        currentServerIndex = index;
        lastIframeServerIndex = index;

        // Stall detection — if the iframe never finishes loading, move on.
        // (A cross-origin iframe that loads an error page still fires 'load',
        // which can't be told apart from a working embed.)
        serverStallTimeout = setTimeout(() => {
          serverLoadingMsg.textContent = `${server.name} is not responding…`;
          failoverToNextServer();
        }, 15000);
      }
    }

    // Hide loading indicator when video loads successfully
    videoPlayer.addEventListener('load', () => {
      // Ignore the blank page used to park the iframe while a torrent plays
      if (videoPlayer.src.startsWith('about:')) return;
      clearTimeout(serverStallTimeout);
      document.getElementById('server-loading').classList.add('hidden');
      startProgressTracking();
    });

    // Auto-switch to next server on load error
    videoPlayer.addEventListener('error', () => {
      clearTimeout(serverStallTimeout);
      const failedName = alternativeServers[currentServerIndex]?.name || 'Server';
      const serverLoadingMsg = document.getElementById('server-loading-msg');
      serverLoadingMsg.textContent = `${failedName} failed, trying next…`;
      setTimeout(failoverToNextServer, 1500);
    });

    document.getElementById('retry-all-btn').addEventListener('click', () => {
      document.getElementById('server-error-overlay').classList.add('hidden');
      loadServer(0);
    });
    document.getElementById('report-issue-btn-overlay').addEventListener('click', reportIssue);
    
    serverSelect.addEventListener('change', (e) => {
      const selectedIndex = parseInt(e.target.value);
      loadServer(selectedIndex);
    });
    
    // Populate server select
    serverSelect.innerHTML = '';
    alternativeServers.forEach((server, index) => {
      const option = document.createElement('option');
      option.value = index.toString();
      option.textContent = server.name;
      // If magnet link is provided, select WebTorrent by default
      if (magnetLink && server.playerType === 'webtorrent') {
        option.selected = true;
        currentServerIndex = index;
      } else if (!magnetLink && index === 0) {
        option.selected = true;
        currentServerIndex = 0;
      }
      option.dataset.playerType = server.playerType;
      serverSelect.appendChild(option);
    });

    // Initial load (arms the stall timer). With a magnet link the torrent is
    // loaded instead, so the iframe stays empty.
    if (!magnetLink) {
      loadServer(0);
    }
    checkSavedProgress();

    // If magnet link is provided, auto-load WebTorrent
    if (magnetLink) {
      // Find WebTorrent server index
      const webtorrentIndex = alternativeServers.findIndex(s => s.playerType === 'webtorrent');
      if (webtorrentIndex !== -1) {
        // Wait for DOM to be fully ready, then switch to WebTorrent
        setTimeout(() => {
          console.log('Auto-loading magnet link:', magnetLink);
          // Set the server select value
          serverSelect.value = webtorrentIndex.toString();
          // Load the WebTorrent server (this will open the modal)
          loadServer(webtorrentIndex);
          
          // Wait for modal to open, then pre-fill and auto-load
          setTimeout(() => {
            const magnetInput = document.getElementById('magnet-input') as HTMLInputElement;
            if (magnetInput) {
              // URLSearchParams.get() already decoded the magnet link
              magnetInput.value = magnetLink;
              console.log('Pre-filled magnet link in input');
              
              // Auto-click load button after a short delay
              setTimeout(() => {
                const loadBtn = document.getElementById('load-webtorrent-btn') as HTMLButtonElement;
                if (loadBtn) {
                  console.log('Auto-clicking load button');
                  loadBtn.click();
                } else {
                  console.error('Load button not found');
                }
              }, 300);
            } else {
              console.error('Magnet input not found');
            }
          }, 800); // Give modal time to open
        }, 200);
      }
    }
    
    // WebTorrent functionality
    function showWebTorrentModal() {
      const modal = document.getElementById('webtorrent-modal');
      modal.classList.remove('hidden');
    }
    
    function hideWebTorrentModal() {
      const modal = document.getElementById('webtorrent-modal');
      modal.classList.add('hidden');
    }
    
    async function loadWebTorrent(magnetLink, torrentFile) {
      // Import WebTorrent as ES module (as per official docs: https://esm.sh/webtorrent)
      // Using dynamic import() which works in modern browsers
      const WebTorrentModule = await import('https://esm.sh/webtorrent') as any;
      const WebTorrentClient = WebTorrentModule.default || WebTorrentModule;
      
      // Stop any existing torrent
      if (webtorrentClient) {
        webtorrentClient.destroy();
      }
      
      // Create new WebTorrent client
      webtorrentClient = new WebTorrentClient();
      
      const videoPlayer = document.getElementById('video-player');
      const webtorrentContainer = document.getElementById('webtorrent-container');
      const webtorrentPlayer = document.getElementById('webtorrent-player');
      const webtorrentStatus = document.getElementById('webtorrent-status');
      const webtorrentProgress = document.getElementById('webtorrent-progress');
      const serverLoading = document.getElementById('server-loading');
      
      // Hide iframe (and stop it playing audio underneath), show WebTorrent player
      clearTimeout(serverStallTimeout);
      clearInterval(progressInterval);
      videoPlayer.src = 'about:blank';
      videoPlayer.classList.add('hidden');
      webtorrentContainer.classList.remove('hidden');
      webtorrentProgress.classList.remove('hidden');
      serverLoading.classList.add('hidden');
      hideWebTorrentModal();
      
      // Add torrent
      const torrent = magnetLink 
        ? webtorrentClient.add(magnetLink)
        : webtorrentClient.add(torrentFile);
      
      webtorrentTorrent = torrent;
      
      // Update status
      webtorrentStatus.innerHTML = `
        <div class="flex items-center space-x-2">
          <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
          <span>Connecting to peers...</span>
        </div>
      `;
      
      torrent.on('metadata', () => {
        console.log('Torrent metadata received');
        webtorrentStatus.innerHTML = `
          <div class="flex items-center space-x-2">
            <i class="fas fa-check-circle text-green-400"></i>
            <span>Connected! Finding video file...</span>
          </div>
        `;
        
        // Find the largest video file
        const files = torrent.files;
        let videoFile = null;
        let maxSize = 0;
        
        files.forEach(file => {
          if (file.name.endsWith('.mp4') || file.name.endsWith('.mkv') || 
              file.name.endsWith('.avi') || file.name.endsWith('.webm') ||
              file.name.endsWith('.mov')) {
            if (file.length > maxSize) {
              maxSize = file.length;
              videoFile = file;
            }
          }
        });
        
        if (!videoFile && files.length > 0) {
          // If no video file found, use the largest file
          files.forEach(file => {
            if (file.length > maxSize) {
              maxSize = file.length;
              videoFile = file;
            }
          });
        }
        
        if (videoFile) {
          console.log('Playing video file:', videoFile.name);
          videoFile.renderTo(webtorrentPlayer, {
            autoplay: true,
            controls: true
          });
          
          webtorrentStatus.innerHTML = `
            <div class="flex items-center space-x-2">
              <i class="fas fa-play-circle text-green-400"></i>
              <span>Playing: ${escapeHtml(videoFile.name)}</span>
            </div>
          `;
        } else {
          webtorrentStatus.innerHTML = `
            <div class="flex items-center space-x-2">
              <i class="fas fa-exclamation-triangle text-yellow-400"></i>
              <span>No video file found in torrent</span>
            </div>
          `;
        }
      });
      
      torrent.on('download', () => {
        const progress = (torrent.progress * 100).toFixed(1);
        const downloadSpeed = (torrent.downloadSpeed / 1024 / 1024).toFixed(2);
        const uploadSpeed = (torrent.uploadSpeed / 1024 / 1024).toFixed(2);
        const peers = torrent.numPeers;
        
        document.getElementById('progress-bar').style.width = `${progress}%`;
        document.getElementById('progress-text').textContent = `${progress}%`;
        document.getElementById('download-speed').textContent = downloadSpeed;
        document.getElementById('upload-speed').textContent = uploadSpeed;
        document.getElementById('peer-count').textContent = peers;
      });
      
      torrent.on('done', () => {
        webtorrentStatus.innerHTML = `
          <div class="flex items-center space-x-2">
            <i class="fas fa-check-circle text-green-400"></i>
            <span>Download complete!</span>
          </div>
        `;
      });
      
      torrent.on('error', (err) => {
        console.error('Torrent error:', err);
        webtorrentStatus.innerHTML = `
          <div class="flex items-center space-x-2">
            <i class="fas fa-exclamation-circle text-red-400"></i>
            <span>Error: ${escapeHtml(err.message)}</span>
          </div>
        `;
      });
    }
    
    // WebTorrent modal handlers
    // Cancelling the modal goes back to the last iframe server (unless a torrent is already playing)
    function cancelWebTorrentModal() {
      hideWebTorrentModal();
      if (webtorrentClient) {
        serverSelect.selectedIndex = currentServerIndex;
        return;
      }
      const src = videoPlayer.getAttribute('src');
      if (!src || src.startsWith('about:')) {
        loadServer(lastIframeServerIndex);
      } else {
        // Iframe was never touched, just restore the selection
        serverSelect.selectedIndex = lastIframeServerIndex;
        currentServerIndex = lastIframeServerIndex;
      }
    }
    document.getElementById('close-webtorrent-modal')?.addEventListener('click', cancelWebTorrentModal);
    document.getElementById('cancel-webtorrent-btn')?.addEventListener('click', cancelWebTorrentModal);
    
    document.getElementById('load-webtorrent-btn')?.addEventListener('click', async () => {
      const magnetInput = document.getElementById('magnet-input');
      const torrentFileInput = document.getElementById('torrent-file-input');
      
      const magnetLink = magnetInput.value.trim();
      const torrentFile = torrentFileInput.files[0];
      
      if (!magnetLink && !torrentFile) {
        alert('Please enter a magnet link or select a torrent file');
        return;
      }
      
      try {
        await loadWebTorrent(magnetLink || null, torrentFile || null);
      } catch (error) {
        console.error('Error loading WebTorrent:', error);
        alert('Error loading torrent: ' + error.message);
      }
    });
    
    // Allow Enter key to submit magnet link
    document.getElementById('magnet-input')?.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        document.getElementById('load-webtorrent-btn')?.click();
      }
    });
    
    // Set up TV show episode controls if needed
    if (type === 'tv') {
      setupTVControls(id, season, episode, switchEpisode);
    }
  }
  
  
  function showError() {
    const loadingScreen = document.getElementById('loading-screen');
    const errorScreen = document.getElementById('error-screen');
    const playerContainer = document.getElementById('player-container');
    
    loadingScreen.classList.add('hidden');
    playerContainer.classList.add('hidden');
    errorScreen.classList.remove('hidden');
  }
  
  async function setupTVControls(id, currentSeason, currentEpisode, switchEpisode) {
    const episodeControls = document.getElementById('episode-controls');
    const seasonSelect = document.getElementById('season-select');
    const episodeSelect = document.getElementById('episode-select');
    const loadEpisodeBtn = document.getElementById('load-episode-btn');
    const episodeInfo = document.getElementById('episode-info');
    const episodeTitle = document.getElementById('episode-title');
    const episodeOverview = document.getElementById('episode-overview');
    
    episodeControls.classList.remove('hidden');

    // Track episode counts and runtimes for auto-next
    let episodeCountBySeason = {};
    let episodeRuntimes = {}; // { season: { episodeNum: runtimeMinutes } }
    let episodesBySeason = {}; // { season: TMDB episode list } for the episode info panel
    let optionsSeason = null; // season the episode <select> currently lists
    let optionsRequestId = 0; // guards against out-of-order season fetches
    let maxSeasons = 10;

    // Try to get real TV show data from TMDB
    let tvShowData = null;
    try {
      const response = await fetch(`https://api.themoviedb.org/3/tv/${id}?api_key=${import.meta.env.PUBLIC_TMDB_API_KEY}`);
      if (response.ok) {
        tvShowData = await response.json();
      }
    } catch (e) {
      console.log('Could not fetch TV show data:', e);
    }

    // Populate season options
    seasonSelect.innerHTML = '';
    maxSeasons = tvShowData?.number_of_seasons || 10;
    for (let i = 1; i <= maxSeasons; i++) {
      const option = document.createElement('option');
      option.value = i;
      option.textContent = `Season ${i}`;
      option.selected = i == currentSeason;
      seasonSelect.appendChild(option);
    }
    
    // Populate episode options
    // Returns false if a newer request superseded this one
    async function updateEpisodeOptions(selectedSeason, selectedEpisode = 1) {
      const requestId = ++optionsRequestId;
      
      // Try to get real episode data
      let seasonData = null;
      try {
        const response = await fetch(`https://api.themoviedb.org/3/tv/${id}/season/${selectedSeason}?api_key=${import.meta.env.PUBLIC_TMDB_API_KEY}`);
        if (response.ok) {
          seasonData = await response.json();
        }
      } catch (e) {
        console.log('Could not fetch season data:', e);
      }
      
      if (requestId !== optionsRequestId) return false;
      episodeSelect.innerHTML = '';
      
      const episodes = seasonData?.episodes || [];
      // If the season fetch failed, fall back to the show's own episode count before guessing
      const showSeasonCount = tvShowData?.seasons?.find(s => s.season_number == selectedSeason)?.episode_count;
      const maxEpisodes = episodes.length || showSeasonCount || 24;
      episodesBySeason[selectedSeason] = episodes;
      optionsSeason = String(selectedSeason);
      episodeCountBySeason[selectedSeason] = maxEpisodes;
      episodeRuntimes[selectedSeason] = {};
      episodes.forEach((ep, i) => { if (ep?.runtime) episodeRuntimes[selectedSeason][i + 1] = ep.runtime; });

      for (let i = 1; i <= maxEpisodes; i++) {
        const option = document.createElement('option');
        option.value = i;
        const episodeData = episodes[i - 1];
        option.textContent = episodeData?.name ? `${i}. ${episodeData.name}` : `Episode ${i}`;
        option.selected = i == selectedEpisode;
        episodeSelect.appendChild(option);
      }
      
      // Update episode info if available
      updateEpisodeInfo(selectedSeason, episodeSelect.value, episodes);
      return true;
    }
    
    function updateEpisodeInfo(season, episode, episodes = []) {
      const episodeData = episodes[episode - 1];
      if (episodeData) {
        episodeTitle.textContent = `S${season}E${episode}: ${episodeData.name}`;
        episodeOverview.textContent = episodeData.overview || 'No description available.';
        episodeInfo.classList.remove('hidden');
      } else {
        episodeInfo.classList.add('hidden');
      }
    }
    
    await updateEpisodeOptions(currentSeason, currentEpisode);
    
    // Function to load a specific episode.
    // Keeps the selects, URL, progress tracking and auto-next state in sync.
    async function loadEpisode(season, episode, pushHistory = true) {
      season = String(season);
      episode = String(episode);

      // Make sure the episode <select> lists this season before selecting from it
      if (optionsSeason !== season) {
        const ok = await updateEpisodeOptions(season, episode);
        if (!ok) return; // superseded by a newer season change
      }
      seasonSelect.value = season;
      episodeSelect.value = episode;
      updateEpisodeInfo(season, episode, episodesBySeason[season] || []);

      // Update URL without reloading
      if (pushHistory) {
        const url = new URL(window.location.href);
        url.searchParams.set('season', season);
        url.searchParams.set('episode', episode);
        window.history.pushState({}, '', url);
      }

      // Reset auto-next state for the new episode
      resetAutoNext();

      // Updates title, resets progress and reloads the active iframe server
      switchEpisode(season, episode);
    }
    
    // Handle episode changes (with auto-loading)
    episodeSelect.addEventListener('change', () => {
      loadEpisode(seasonSelect.value, episodeSelect.value);
    });
    
    // Changing season auto-plays episode 1 of the new season
    seasonSelect.addEventListener('change', () => {
      loadEpisode(seasonSelect.value, 1);
    });
    
    // Load episode button handler (now just calls the loadEpisode function)
    loadEpisodeBtn.addEventListener('click', () => {
      loadEpisode(seasonSelect.value, episodeSelect.value);
    });

    // Back/forward buttons: follow the season/episode in the URL
    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(window.location.search);
      loadEpisode(params.get('season') || '1', params.get('episode') || '1', false);
    });

    // --- Auto Next Episode ---
    const nextOverlay = document.getElementById('next-episode-overlay');
    const nextLabel = document.getElementById('next-episode-label');
    const nextCountdownEl = document.getElementById('next-episode-countdown');
    const nextPlayBtn = document.getElementById('next-episode-play-btn');
    const nextCancelBtn = document.getElementById('next-episode-cancel-btn');
    let countdownInterval = null;
    let autoNextTriggered = false;
    let autoNextCancelled = false;

    function getNextEpisodeInfo() {
      const curSeason = parseInt(seasonSelect.value);
      const curEpisode = parseInt(episodeSelect.value);
      const episodesInSeason = episodeCountBySeason[curSeason] || episodeSelect.options.length;
      if (curEpisode < episodesInSeason) return { season: curSeason, episode: curEpisode + 1 };
      if (curSeason < maxSeasons) return { season: curSeason + 1, episode: 1 };
      return null;
    }

    function doAutoNext() {
      if (autoNextTriggered || autoNextCancelled) return;
      autoNextTriggered = true;
      clearInterval(countdownInterval);
      nextOverlay.classList.add('hidden');
      const next = getNextEpisodeInfo();
      if (!next) return;
      localStorage.removeItem(`notflix_progress_tv_${id}_s${seasonSelect.value}_e${episodeSelect.value}`);

      const playerIframe = document.getElementById('video-player');
      const playerEl = playerIframe.parentElement;

      // Enter fullscreen now while we still have a user-gesture context,
      // then swap the src. The new episode loads inside the live fullscreen
      // session which keeps the autoplay permission active.
      const goNext = () => {
        // loadEpisode refreshes the episode list first when crossing a season boundary
        loadEpisode(next.season, next.episode);
      };

      if (playerEl?.requestFullscreen && !document.fullscreenElement) {
        playerEl.requestFullscreen().then(goNext).catch(goNext);
      } else {
        goNext();
      }
    }

    function showNextEpisodeOverlay() {
      if (autoNextCancelled || autoNextTriggered) return;
      const next = getNextEpisodeInfo();
      if (!next) return;
      nextLabel.textContent = `Season ${next.season}, Episode ${next.episode}`;
      let secs = 5;
      nextCountdownEl.textContent = secs;
      nextOverlay.classList.remove('hidden');
      clearInterval(countdownInterval);
      countdownInterval = setInterval(() => {
        secs--;
        nextCountdownEl.textContent = secs;
        if (secs <= 0) {
          clearInterval(countdownInterval);
          doAutoNext();
        }
      }, 1000);
    }

    // Duration-based end detection: when the embed tells us the video duration
    // and current position, we set a precise timer for the actual remaining time.
    let videoDuration = null;
    let videoCurrentTime = 0;
    let endTimer = null;

    function clearEndTimer() {
      clearTimeout(endTimer);
      endTimer = null;
    }

    function setEndTimer() {
      clearEndTimer();
      if (!videoDuration) return;
      const remaining = Math.max(videoDuration - videoCurrentTime, 0) * 1000;
      if (remaining < 2000) return;
      endTimer = setTimeout(() => {
        endTimer = null;
        showNextEpisodeOverlay();
      }, remaining);
    }

    function resetAutoNext() {
      clearInterval(countdownInterval);
      clearEndTimer();
      autoNextTriggered = false;
      autoNextCancelled = false;
      videoDuration = null;
      videoCurrentTime = 0;
      nextOverlay.classList.add('hidden');
    }

    nextPlayBtn.addEventListener('click', () => {
      clearInterval(countdownInterval);
      doAutoNext();
    });

    nextCancelBtn.addEventListener('click', () => {
      clearInterval(countdownInterval);
      clearEndTimer();
      autoNextCancelled = true;
      nextOverlay.classList.add('hidden');
    });

    // Listen to every postMessage from the embed.
    // Log everything so we know exactly what events VidSrc sends.
    // Capture duration + currentTime to drive a precise end timer.
    window.addEventListener('message', (e) => {
      if (!isEmbedMessage(e)) return;
      try {
        const raw = typeof e.data === 'string' ? e.data : JSON.stringify(e.data);
        const data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
        if (!data) return;

        // Log every message from the embed so we can see what's available
        console.log('[embed msg]', raw.slice(0, 300));

        // Extract duration and position from whatever field name the player uses
        const dur = data.duration ?? data.totalTime ?? data.length ?? data.total;
        const cur = data.currentTime ?? data.position ?? data.time ?? data.current;

        if (dur != null && !isNaN(dur) && parseFloat(dur) > 10) {
          const prev = videoDuration;
          videoDuration = parseFloat(dur);
          if (prev !== videoDuration) console.log(`[embed] duration locked: ${videoDuration}s`);
        }
        if (cur != null && !isNaN(cur)) {
          videoCurrentTime = parseFloat(cur);
        }

        const evt = (data.event ?? data.type ?? data.name ?? data.status ?? '').toString().toLowerCase();
        if (evt) console.log(`[embed] event="${evt}" cur=${videoCurrentTime?.toFixed(1)} dur=${videoDuration?.toFixed(1)}`);

        // Play / resume → set timer for remaining time
        if (evt === 'play' || evt === 'playing') {
          setEndTimer();
        }

        // Pause → cancel timer so it doesn't fire while paused
        if (evt === 'pause' || evt === 'paused') {
          clearEndTimer();
        }

        // Seek / scrub → update position and reset timer to new remaining time
        if (evt === 'seek' || evt === 'seeked' || evt === 'seeking') {
          setEndTimer();
        }

        // timeupdate → re-sync the timer to the real position so stalls/buffering
        // don't make it fire early
        if (evt === 'timeupdate') {
          if (videoDuration) setEndTimer();
        }

        // Ended signal → show overlay immediately
        if (evt === 'ended' || evt === 'complete' || evt === 'finish' || evt === 'stop') {
          clearEndTimer();
          showNextEpisodeOverlay();
        }
      } catch (_) {}
    });

    // --- Fullscreen episode controls ---
    const fsControls  = document.getElementById('fullscreen-controls');
    const fsTrigger   = document.getElementById('fs-trigger-zone');
    const fsPrevBtn   = document.getElementById('fs-prev-btn');
    const fsNextBtn   = document.getElementById('fs-next-btn');
    const fsSeasonSel = document.getElementById('fs-season-select');
    const fsEpisodeSel= document.getElementById('fs-episode-select');
    const fsTitleEl   = document.getElementById('fs-title');
    const fsEpLabel   = document.getElementById('fs-ep-label');
    let fsHideTimer   = null;

    function syncFsSelects() {
      fsSeasonSel.innerHTML  = seasonSelect.innerHTML;
      fsSeasonSel.value      = seasonSelect.value;
      fsEpisodeSel.innerHTML = episodeSelect.innerHTML;
      fsEpisodeSel.value     = episodeSelect.value;
      const showTitle = new URLSearchParams(window.location.search).get('title') || '';
      fsTitleEl.textContent  = showTitle;
      fsEpLabel.textContent  = `Season ${seasonSelect.value}  ·  Episode ${episodeSelect.value}`;
    }

    function showFsControls() {
      if (!document.fullscreenElement) return;
      syncFsSelects();
      fsControls.classList.remove('hidden');
      // Disable iframe pointer events so our controls can receive clicks
      document.getElementById('video-player').style.pointerEvents = 'none';
      // Step back the trigger zone so it doesn't block clicks on the controls above it
      fsTrigger.style.pointerEvents = 'none';
      clearTimeout(fsHideTimer);
      fsHideTimer = setTimeout(hideFsNow, 4000);
    }

    function hideFsNow() {
      fsControls.classList.add('hidden');
      document.getElementById('video-player').style.pointerEvents = 'auto';
      fsTrigger.style.pointerEvents = 'auto';
    }

    function hideFsControls(delay = 1500) {
      clearTimeout(fsHideTimer);
      fsHideTimer = setTimeout(hideFsNow, delay);
    }

    fsTrigger.addEventListener('mouseenter', showFsControls);
    fsTrigger.addEventListener('mousemove',  showFsControls);
    fsControls.addEventListener('mouseenter', () => clearTimeout(fsHideTimer));
    fsControls.addEventListener('mouseleave', () => hideFsControls());

    document.addEventListener('fullscreenchange', () => {
      // The hover strip only exists in fullscreen; outside it must not block the embed's top edge
      fsTrigger.style.pointerEvents = document.fullscreenElement ? 'auto' : 'none';
      if (!document.fullscreenElement) {
        clearTimeout(fsHideTimer);
        fsControls.classList.add('hidden');
        document.getElementById('video-player').style.pointerEvents = 'auto';
      }
    });

    fsPrevBtn.addEventListener('click', async () => {
      const s = parseInt(seasonSelect.value);
      const e = parseInt(episodeSelect.value);
      if (e > 1) {
        loadEpisode(s, e - 1);
      } else if (s > 1) {
        // Need the previous season's episode count to jump to its last episode
        const ok = await updateEpisodeOptions(s - 1, 1);
        if (!ok) return;
        loadEpisode(s - 1, episodeCountBySeason[s - 1] || 1);
      }
    });

    fsNextBtn.addEventListener('click', () => {
      const next = getNextEpisodeInfo();
      if (!next) return;
      loadEpisode(next.season, next.episode);
    });

    fsSeasonSel.addEventListener('change', async () => {
      await loadEpisode(fsSeasonSel.value, 1);
      syncFsSelects();
    });

    fsEpisodeSel.addEventListener('change', () => {
      loadEpisode(seasonSelect.value, fsEpisodeSel.value);
    });
  }

  function setupPopupBlocker() {
    // Additional iframe protection
    const iframe = document.getElementById('video-player');
    if (!iframe) return;
    
    // Intercept iframe navigation attempts
    iframe.addEventListener('load', () => {
      try {
        // Add additional security headers via meta injection
        const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
        if (iframeDoc) {
          // Try to inject popup blocking script into iframe (may be blocked by CORS)
          const script = iframeDoc.createElement('script');
          script.textContent = `
            window.open = function() { return null; };
            document.addEventListener('click', function(e) {
              if (e.target.tagName === 'A' && e.target.target === '_blank') {
                e.preventDefault();
                e.stopPropagation();
                return false;
              }
            }, true);
          `;
          iframeDoc.head?.appendChild(script);
        }
      } catch (e) {
        // CORS will prevent this, but we try anyway - this is expected and not an error
        // Silently handle - no need to log
      }
    });
    
    // Monitor for suspicious activity
    let clickCount = 0;
    const clickThreshold = 3;
    const timeWindow = 2000; // 2 seconds
    
    document.addEventListener('click', (e) => {
      clickCount++;
      setTimeout(() => { clickCount--; }, timeWindow);
      
      if (clickCount > clickThreshold) {
        console.warn('Suspicious click activity detected - potential ad injection');
        // Could add visual warning here
      }
    });
    
    // Block context menus on video player (often used for ad injection)
    iframe.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      return false;
    });
    
    // Detect and block redirect attempts
    let lastUrl = window.location.href;
    const urlWatchTimer = setInterval(() => {
      if (window.location.href !== lastUrl) {
        // URL changed unexpectedly, might be a redirect attempt
        console.warn('Unexpected URL change detected');
        lastUrl = window.location.href;
      }
    }, 500);
    window.addEventListener('pagehide', () => clearInterval(urlWatchTimer), { once: true });
  }
  
  // Advanced popup detection and blocking
  function enhancedPopupBlocker() {
    // Block document.open calls
    const originalDocOpen = document.open;
    document.open = function() {
      console.log('Blocked document.open call');
      return null;
    };
    
    // Block createElement for popup elements
    const originalCreateElement = document.createElement;
    document.createElement = function(tagName) {
      const element = originalCreateElement.call(document, tagName);
      
      if (tagName.toLowerCase() === 'a') {
        // Intercept link creation and remove target="_blank"
        const originalSetAttribute = element.setAttribute;
        element.setAttribute = function(name, value) {
          if (name === 'target' && value === '_blank') {
            console.log('Blocked target="_blank" on dynamically created link');
            showPopupBlockedNotification();
            return;
          }
          return originalSetAttribute.call(this, name, value);
        };
      }
      
      return element;
    };
    
    // Block form submissions that could open popups
    document.addEventListener('submit', (e) => {
      const form = e.target;
      if (form.target === '_blank') {
        console.log('Blocked form submission with target="_blank"');
        showPopupBlockedNotification();
        e.preventDefault();
        return false;
      }
    });
  }
  
  // Initialize enhanced blocking
  enhancedPopupBlocker();
  
  // Fullscreen functionality
  function toggleFullscreen() {
    const videoPlayer = document.getElementById('video-player');
    const playerContainer = videoPlayer?.parentElement;
    if (playerContainer) {
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else {
        playerContainer.requestFullscreen();
      }
    }
  }
  
  // Report issue functionality
  function reportIssue() {
    const currentUrl = window.location.href;
    const title = document.getElementById('content-title')?.textContent || 'Unknown';
    
    const message = `Issue Report for: ${title}\nURL: ${currentUrl}\n\nPlease describe the issue:`;
    
    if (confirm('Report a playback issue? This will open your email client.')) {
      window.location.href = `mailto:support@notflix.com?subject=Playback Issue Report&body=${encodeURIComponent(message)}`;
    }
  }
  
  // Make functions globally available
  window.toggleFullscreen = toggleFullscreen;
  window.reportIssue = reportIssue;
  
  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    switch(e.key) {
      case 'f':
      case 'F':
        if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA') {
          e.preventDefault();
          toggleFullscreen();
        }
        break;
      case 'Escape':
        if (document.fullscreenElement) {
          document.exitFullscreen();
        }
        break;
    }
  });
</script>

<!-- Amazon Silk Browser Fixes -->
<style>
  /* Amazon Silk iframe scroll fix */
  .amazon-silk-fix {
    -webkit-overflow-scrolling: touch;
    transform: translateZ(0);
    will-change: transform;
  }
  
  .amazon-silk-iframe {
    pointer-events: auto;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  
  /* Silk browser detection and fixes */
  @media screen and (-webkit-min-device-pixel-ratio: 0) {
    body.silk-browser {
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
    }
    
    body.silk-browser .amazon-silk-fix {
      position: relative;
      z-index: 1;
    }
    
    body.silk-browser .amazon-silk-iframe {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
      border: none;
      outline: none;
      touch-action: manipulation;
    }
  }
  
  /* Force scrolling capability */
  html, body {
    touch-action: pan-y;
    -webkit-overflow-scrolling: touch;
  }
</style>

<script>
  // Amazon Silk browser detection and fixes
  function detectAndFixSilkBrowser() {
    const userAgent = navigator.userAgent || navigator.vendor || window.opera;
    const isSilk = /Silk|silk/i.test(userAgent);
    const isFireTV = /AFTK|AFTB|AFTM|AFTN|AFTR|AFTD|AFHE|AFTI|AFTS|AFMM|AFKN|AFT/i.test(userAgent);
    
    if (isSilk || isFireTV) {
      document.body.classList.add('silk-browser');
      
      // Force enable scrolling
      document.body.style.overflow = 'auto';
      document.documentElement.style.overflow = 'auto';
      
      // Fix iframe interaction issues
      const iframe = document.getElementById('video-player');
      if (iframe) {
        // Add touch-action to prevent scroll blocking
        iframe.style.touchAction = 'manipulation';
        
        // Ensure iframe doesn't block scrolling
        iframe.addEventListener('load', function() {
          // Reset scrolling capability after iframe loads
          setTimeout(() => {
            document.body.style.overflow = 'auto';
            document.documentElement.style.overflow = 'auto';
            
            // Enable touch scrolling
            document.body.style.webkitOverflowScrolling = 'touch';
            document.documentElement.style.webkitOverflowScrolling = 'touch';
          }, 1000);
        });
        
        // Handle iframe src changes
        const originalSetAttribute = iframe.setAttribute;
        iframe.setAttribute = function(name, value) {
          originalSetAttribute.call(this, name, value);
          if (name === 'src') {
            setTimeout(() => {
              document.body.style.overflow = 'auto';
              document.documentElement.style.overflow = 'auto';
            }, 2000);
          }
        };
      }
      
      // Add scroll restoration
      let scrollRestoreTimer;
      function restoreScrolling() {
        clearTimeout(scrollRestoreTimer);
        scrollRestoreTimer = setTimeout(() => {
          document.body.style.overflow = 'auto';
          document.documentElement.style.overflow = 'auto';
          document.body.style.webkitOverflowScrolling = 'touch';
          document.documentElement.style.webkitOverflowScrolling = 'touch';
        }, 100);
      }
      
      // Monitor for scroll blocking and restore
      setInterval(restoreScrolling, 5000);
      
      // Restore scrolling on touch events
      document.addEventListener('touchstart', restoreScrolling);
      document.addEventListener('touchmove', restoreScrolling);
      
      console.log('Amazon Silk browser detected - scroll fixes applied');
    }
  }
  
  // Apply fixes when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', detectAndFixSilkBrowser);
  } else {
    detectAndFixSilkBrowser();
  }
</script>
